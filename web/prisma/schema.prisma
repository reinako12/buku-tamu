// Skema Prisma — sumber kebenaran struktur tabel.
//
// Catatan penting:
// - `profiles.id` adalah UUID yang sama dengan auth.users.id (Supabase Auth).
//   Relasi FK-nya sengaja TIDAK dimodelkan di sini karena tabel auth.users
//   milik Supabase. Kalau nanti pindah ke Postgres biasa, kolom ini tinggal
//   dipakai sebagai id user dari tabel users aplikasi.
// - Fungsi `create_visit` (alokasi nomor antrian) dan RLS TIDAK ada di schema
//   Prisma. Keduanya hidup di migration SQL manual (0001_functions_rls).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VisitStatus {
  menunggu
  dipanggil
  dilayani
  selesai
  batal

  @@map("visit_status")
}

enum StaffRole {
  petugas
  admin

  @@map("staff_role")
}

enum VisitSource {
  mandiri
  manual

  @@map("visit_source")
}

/// Jenis kelamin tamu. 'lk' = laki-laki, 'pr' = perempuan.
enum Gender {
  lk
  pr

  @@map("visit_gender")
}

/// Status percakapan chat. 'terbuka' = tamu masih bisa menulis.
enum ConversationStatus {
  terbuka
  ditutup

  @@map("conversation_status")
}

enum MessageSender {
  tamu
  petugas
  sistem

  @@map("message_sender")
}

enum ConversationSource {
  web
  manual

  @@map("conversation_source")
}

model Profile {
  id        String    @id @db.Uuid
  fullName  String    @map("full_name")
  role      StaffRole @default(petugas)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  visits   Visit[]   @relation("handled_by")
  messages Message[]

  @@map("profiles")
}

model Visit {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String      @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queueDate      DateTime    @map("queue_date") @db.Date
  queueSeq       Int         @map("queue_seq")
  queueNo        String      @unique @map("queue_no")
  name           String
  institution    String
  institutionCat String      @map("institution_cat")
  phone          String
  purpose        String
  detail         String?
  personCount    Int         @default(1) @map("person_count") @db.SmallInt
  status         VisitStatus @default(menunggu)
  source         VisitSource @default(mandiri)
  gender         Gender?
  handledBy      String?     @map("handled_by") @db.Uuid
  internalNote   String?     @map("internal_note")
  checkInAt      DateTime    @default(now()) @map("check_in_at") @db.Timestamptz(6)
  checkOutAt     DateTime?   @map("check_out_at") @db.Timestamptz(6)

  handler Profile? @relation("handled_by", fields: [handledBy], references: [id], onDelete: SetNull)

  conversation Conversation?

  @@unique([queueDate, queueSeq])
  @@index([queueDate(sort: Desc), queueSeq(sort: Desc)])
  @@index([status])
  @@index([phone])
  @@map("visits")
}

model Setting {
  id           Int       @id @default(1) @db.SmallInt
  isOpen       Boolean   @default(true) @map("is_open")
  closedReason String?   @map("closed_reason")
  reopenAt     DateTime? @map("reopen_at") @db.Timestamptz(6)
  autoReopen   Boolean   @default(true) @map("auto_reopen")
  autoReply    String?   @map("auto_reply")
  autoReplyEn  String?   @map("auto_reply_en")
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

/// Percakapan chat. Tidak menempel ke kunjungan sejak awal; `visitId` diisi
/// belakangan kalau tamu check-in dengan nomor yang sama.
///
/// Aturan "satu nomor hanya boleh punya satu percakapan terbuka" dijaga
/// partial unique index di migrasi 0004 — Prisma tidak bisa memodelkannya,
/// jadi jangan hapus index itu saat menyusun diff.
model Conversation {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId        String?            @unique @map("visit_id") @db.Uuid
  guestName      String             @map("guest_name")
  guestPhone     String             @map("guest_phone")
  status         ConversationStatus @default(terbuka)
  source         ConversationSource @default(web)
  lastMessageAt  DateTime?          @map("last_message_at") @db.Timestamptz(6)
  staffLastReadAt DateTime?         @map("staff_last_read_at") @db.Timestamptz(6)
  guestLastReadAt DateTime?         @map("guest_last_read_at") @db.Timestamptz(6)
  autoRepliedAt  DateTime?          @map("auto_replied_at") @db.Timestamptz(6)
  /// Bahasa tamu ("id" / "en"): penentu bahasa pesan sistem yang tersimpan.
  locale         String             @default("id")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz(6)

  visit    Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([guestPhone])
  @@map("conversations")
}

model Message {
  seq            BigInt        @id @default(autoincrement())
  id             String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  sender         MessageSender
  staffId        String?       @map("staff_id") @db.Uuid
  body           String
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff        Profile?     @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([conversationId, seq])
  @@map("messages")
}
